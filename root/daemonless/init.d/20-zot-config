#!/bin/sh

mkdir -p /config /data

# A working registry out of the box: images in /data, the UI and search on.
# CVE scanning is off: it downloads about 1 GB of vulnerability databases on
# the first start. Turn it on by adding "cve": {"updateInterval": "24h"}
# under "search". Auth, TLS, sync and the rest:
# https://zotregistry.dev/latest/admin-guide/admin-configuration/
if [ ! -f /config/config.json ]; then
    cat > /config/config.json << 'EOF'
{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/data"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000"
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    }
  }
}
EOF
    echo "Created default /config/config.json"
fi

chown -R bsd:bsd /config /data
